## ---- 0. Configuration ----------------------------------------------------------
## Paths are resolved relative to a project root. Define PROJECT_ROOT
## (e.g. in .Renviron) or simply run the script from the project folder.
cfg <- list(
  root     = Sys.getenv("PROJECT_ROOT", unset = getwd()),
  in_dir   = ".",
  out_dir  = ".",
  f_class  = "trajectory_classes.rds",  # list: <cohort>$class_results (ID, GBTM)
  f_event  = "event_followup.rds",      # ID, Data_Source, Arthritis_Status, Arthritis_Time_Years
  f_panel  = "analytic_panel.RData",    # long-format panel with baseline covariates
  panel_nm = NULL                       # object name inside .RData (NULL = first object)
)

in_path  <- function(f) file.path(cfg$root, cfg$in_dir, f)
out_path <- function(f) {
  d <- file.path(cfg$root, cfg$out_dir)
  if (!dir.exists(d)) dir.create(d, recursive = TRUE)
  file.path(d, f)
}
log_msg <- function(fmt, ...) message(sprintf(fmt, ...))
fmt_p   <- function(p, digits = 3) {
  ifelse(is.na(p), "",
         ifelse(p < 0.001, "<0.001", formatC(p, format = "f", digits = digits)))
}
read_rdata_obj <- function(path, which = NULL) {
  env <- new.env(parent = emptyenv())
  nm  <- load(path, envir = env)
  env[[if (is.null(which)) nm[1] else which]]
}
write_book <- function(sheets, file) {
  wb <- createWorkbook()
  iwalk(sheets, function(df, nm) { addWorksheet(wb, nm); writeData(wb, nm, df) })
  saveWorkbook(wb, file, overwrite = TRUE)
  log_msg("Workbook written: %s", basename(file))
}

## ---- 1. Study constants --------------------------------------------------------
.cohorts    <- c("CHARLS", "HRS", "ELSA", "KLoSA")
.base_wave  <- c(CHARLS = 1L, HRS = 8L, ELSA = 2L, KLoSA = 3L)
.cohort_lab <- c(CHARLS = "CHARLS (China)",  HRS   = "HRS (United States)",
                 ELSA   = "ELSA (England)",  KLoSA = "KLoSA (South Korea)")

.traj_lv  <- c("High grip strength", "Moderate grip strength", "Low grip strength")
.ref_lv   <- .traj_lv[1]
## latent class index -> substantive label (fixed across cohorts, consistent with Fig. 3)
.class_key <- c(`1` = "Moderate grip strength",
                `2` = "High grip strength",
                `3` = "Low grip strength")
.traj_pal <- setNames(c("#2166AC", "#66BD63", "#BC3C29"), .traj_lv)
.models   <- c("Model 1", "Model 2", "Model 3")

.baseline_covars <- c("Age", "Gender", "Education", "Marital_Status",
                      "Smoking", "Drinking", "BMI", "Depression",
                      "Hypertension", "Diabetes_Mellitus", "Heart_Disease",
                      "Stroke", "Cancer", "Chronic_Lung_Disease")

## landmark times (years) for tabulated cumulative incidence
.landmarks <- list(CHARLS = c(2, 4), HRS = c(4, 8), ELSA = c(4, 8), KLoSA = c(4, 8))

## ---- 2. Inputs -----------------------------------------------------------------
log_msg("Loading inputs ...")
traj_obj  <- readRDS(in_path(cfg$f_class))
event_tbl <- readRDS(in_path(cfg$f_event)) %>% mutate(ID = as.character(ID))
panel_tbl <- read_rdata_obj(in_path(cfg$f_panel), cfg$panel_nm) %>%
  mutate(ID = as.character(ID))

## ---- 3. Cohort-specific analytic data -----------------------------------------
assemble_cohort <- function(db, covariates = FALSE) {

  cls <- traj_obj[[db]]$class_results %>%
    mutate(ID = as.character(ID),
           Traj_Label = factor(unname(.class_key[as.character(GBTM)]), levels = .traj_lv)) %>%
    select(ID, GBTM, Traj_Label)

  if (covariates) {
    cls <- cls %>%
      left_join(panel_tbl %>%
                  filter(Data_Source == db, Wave == .base_wave[[db]]) %>%
                  select(ID, all_of(.baseline_covars)),
                by = "ID")
  }

  out <- cls %>%
    left_join(event_tbl %>%
                filter(Data_Source == db) %>%
                select(ID, Arthritis_Status, Arthritis_Time_Years),
              by = "ID") %>%
    filter(!is.na(Arthritis_Status), !is.na(Arthritis_Time_Years))

  if (covariates) {
    out <- out %>%
      mutate(across(c(Gender, Education, Smoking, Drinking, Marital_Status), factor),
             Traj_Label = relevel(Traj_Label, ref = .ref_lv))
  }

  log_msg("  %-6s n = %d | classes %s | events = %d (%.1f%%)",
          db, nrow(out), paste(table(out$Traj_Label), collapse = "/"),
          as.integer(sum(out$Arthritis_Status)), 100 * mean(out$Arthritis_Status))
  out
}

log_msg("Assembling analytic samples ...")
km_data  <- setNames(lapply(.cohorts, assemble_cohort), .cohorts)
cox_data <- setNames(lapply(.cohorts, assemble_cohort, covariates = TRUE), .cohorts)

## =============================================================================
##  FIGURE 4 : cumulative incidence curves
## =============================================================================
draw_cuminc <- function(dat, title) {

  fml  <- Surv(Arthritis_Time_Years, Arthritis_Status) ~ Traj_Label
  fit  <- survfit(fml, data = dat)
  lr   <- survdiff(fml, data = dat)
  p_lr <- pchisq(lr$chisq, df = n_distinct(dat$Traj_Label) - 1, lower.tail = FALSE)
  p_lab <- if (p_lr < 0.001) "Log-rank P < 0.001" else sprintf("Log-rank P = %.3f", p_lr)

  ## KM survival -> cumulative incidence (1 - S), anchored at the origin
  curve <- tibble(time = fit$time, surv = fit$surv, lo = fit$lower, hi = fit$upper,
                  strata = rep(names(fit$strata), fit$strata)) %>%
    transmute(time,
              ci    = 1 - surv,
              ci_lo = 1 - hi,
              ci_hi = 1 - lo,
              Traj_Label = factor(sub("^Traj_Label=", "", strata), levels = .traj_lv)) %>%
    bind_rows(tibble(time = 0, ci = 0, ci_lo = 0, ci_hi = 0,
                     Traj_Label = factor(.traj_lv, levels = .traj_lv)), .)

  tally <- dat %>%
    group_by(Traj_Label) %>%
    summarise(n = n(), events = sum(Arthritis_Status), .groups = "drop")
  leg <- setNames(sprintf("%s (n=%d, events=%d)", as.character(tally$Traj_Label),
                          as.integer(tally$n), as.integer(tally$events)),
                  as.character(tally$Traj_Label))

  ## x-axis upper bound: maximum follow-up rounded up to an even number
  t_max <- ceiling(max(dat$Arthritis_Time_Years, na.rm = TRUE))
  t_max <- t_max + t_max %% 2

  p <- ggplot(curve, aes(time, ci * 100, colour = Traj_Label, fill = Traj_Label)) +
    geom_ribbon(aes(ymin = ci_lo * 100, ymax = ci_hi * 100), alpha = 0.1, colour = NA) +
    geom_step(linewidth = 0.9) +
    scale_colour_manual(values = .traj_pal, labels = leg) +
    scale_fill_manual(values = .traj_pal, labels = leg) +
    scale_x_continuous(breaks = seq(0, t_max, 2), limits = c(0, t_max),
                       expand = expansion(mult = c(0.01, 0.02))) +
    scale_y_continuous(expand = expansion(mult = c(0.01, 0.05))) +
    annotate("text", x = 0.3, y = Inf, label = p_lab, hjust = 0, vjust = 1.5,
             size = 3.5, fontface = "italic", colour = "#333333") +
    labs(x = "Follow-up time (years)", y = "Cumulative incidence of arthritis (%)",
         title = title, colour = NULL, fill = NULL) +
    theme_minimal(base_size = 11) +
    theme(
      plot.title        = element_text(hjust = 0.5, face = "bold", size = 11),
      axis.title        = element_text(face = "bold", size = 10),
      axis.text         = element_text(size = 9, colour = "#333333"),
      panel.grid.major  = element_line(colour = "#E8E8E8", linewidth = 0.3),
      panel.grid.minor  = element_blank(),
      panel.border      = element_rect(colour = "#CCCCCC", fill = NA, linewidth = 0.5),
      legend.position   = "bottom",
      legend.text       = element_text(size = 8),
      legend.key.width  = unit(1.0, "cm"),
      legend.key.height = unit(0.3, "cm"),
      legend.background = element_blank(),
      legend.key        = element_blank(),
      plot.margin       = margin(t = 8, r = 10, b = 5, l = 8)
    ) +
    guides(colour = guide_legend(nrow = 1, override.aes = list(linewidth = 1)),
           fill   = guide_legend(nrow = 1))

  list(plot = p, p = p_lr, tally = tally, fit = fit)
}

log_msg("Rendering Figure 4 ...")
fig4 <- setNames(lapply(.cohorts, function(db) draw_cuminc(km_data[[db]], .cohort_lab[[db]])),
                 .cohorts)

fig4_panel <- wrap_plots(lapply(fig4, `[[`, "plot"), ncol = 2) +
  plot_annotation(tag_levels = "A",
                  theme = theme(plot.title = element_text(hjust = 0.5, face = "bold", size = 14))) &
  theme(plot.tag = element_text(size = 15, face = "bold"))

print(fig4_panel)
CairoPDF(out_path("Figure4.pdf"), width = 17, height = 10)
print(fig4_panel)

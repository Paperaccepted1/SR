## --- Figure 4 tables ---
cuminc_at <- function(fit, t, db) {
  s <- summary(fit, times = t)
  tibble(Database          = db,
         Traj_Label        = sub("^Traj_Label=", "", s$strata),
         Time_Years        = s$time,
         N_Risk            = s$n.risk,
         N_Event           = s$n.event,
         Cum_Incidence_Pct = round((1 - s$surv)  * 100, 2),
         CI_Lower_Pct      = round((1 - s$upper) * 100, 2),
         CI_Upper_Pct      = round((1 - s$lower) * 100, 2))
}

fig4_events <- imap_dfr(fig4, ~ mutate(.x$tally, Database = .y)) %>%
  mutate(Event_Rate_Pct = round(events / n * 100, 2)) %>%
  select(Database, Traj_Label, n, events, Event_Rate_Pct) %>%
  arrange(match(Database, .cohorts), match(Traj_Label, .traj_lv))

fig4_lr <- tibble(Database = .cohorts, p = map_dbl(fig4, "p")) %>%
  transmute(Database,
            Log_Rank_P   = fmt_p(p, 4),
            Significance = if_else(p < 0.05, "Yes", "No"))

fig4_ci <- map_dfr(.cohorts, ~ cuminc_at(fig4[[.x]]$fit, .landmarks[[.x]], .x))

write_book(list(Event_summary = fig4_events,
                LogRank       = fig4_lr,
                Cum_incidence = fig4_ci),
           out_path("Figure4.xlsx"))

## =============================================================================
##  FIGURE 5 : Cox proportional hazards models + PH diagnostics
## =============================================================================
cox_formulas <- function(db) {
  lhs <- "Surv(Arthritis_Time_Years, Arthritis_Status) ~ "
  blk <- list(
    demo  = c("Traj_Label", "Age", "Gender", "Education"),
    life  = c("Smoking", "Drinking", "BMI"),
    comor = c(if (db != "KLoSA") "Depression",          # depression unavailable in KLoSA
              "Hypertension", "Diabetes_Mellitus", "Heart_Disease", "Stroke")
  )
  rhs <- list(`Model 1` = blk$demo,
              `Model 2` = c(blk$demo, blk$life),
              `Model 3` = c(blk$demo, blk$life, blk$comor))
  lapply(rhs, function(v) as.formula(paste0(lhs, paste(v, collapse = " + "))))
}

fit_cox_suite <- function(dat, db) {
  fs <- cox_formulas(db)
  hr_rows <- list(); ph_rows <- list()

  for (m in names(fs)) {
    ## x/model = TRUE keeps the design matrix so cox.zph() needs no re-evaluation
    fit <- tryCatch(coxph(fs[[m]], data = dat, x = TRUE, model = TRUE),
                    error = function(e) {
                      log_msg("  %s %s: fit failed (%s)", db, m, conditionMessage(e)); NULL
                    })
    if (is.null(fit)) next

    s   <- summary(fit)
    idx <- grep("^Traj_Label", rownames(s$coefficients))
    hr_rows[[m]] <- bind_rows(
      tibble(Database   = db, Model = m,
             Trajectory = sub("^Traj_Label", "", rownames(s$coefficients)[idx]),
             HR = s$conf.int[idx, 1], Lower = s$conf.int[idx, 3], Upper = s$conf.int[idx, 4],
             P  = s$coefficients[idx, 5]),
      tibble(Database = db, Model = m, Trajectory = .ref_lv,
             HR = 1, Lower = 1, Upper = 1, P = NA_real_)
    )
    log_msg("  %s %s: converged, C-index = %.3f", db, m, s$concordance[1])

    zph <- tryCatch(cox.zph(fit),
                    error = function(e) {
                      log_msg("  %s %s: PH test failed (%s)", db, m, conditionMessage(e)); NULL
                    })
    if (!is.null(zph)) {
      tb <- as.data.frame(zph$table)
      ph_rows[[m]] <- tibble(Database = db, Model = m, Term = rownames(tb),
                             Chisq = round(tb$chisq, 3), df = tb$df, P = tb$p)
    }
  }
  list(hr = bind_rows(hr_rows), ph = bind_rows(ph_rows))
}

log_msg("Fitting Cox models ...")
cox_res <- setNames(lapply(.cohorts, function(db) fit_cox_suite(cox_data[[db]], db)), .cohorts)

cox_all <- bind_rows(map(cox_res, "hr")) %>%
  mutate(HR_CI     = if_else(Trajectory == .ref_lv, "1.00 (Ref.)",
                             sprintf("%.2f (%.2f-%.2f)", HR, Lower, Upper)),
         P_display = fmt_p(P))

ph_all <- bind_rows(map(cox_res, "ph")) %>%
  mutate(P_display = fmt_p(P))

## --- forest-plot table and estimate vectors ---
spacer <- strrep(" ", 39)
fp_rows <- list()
fp_est <- fp_lo <- fp_hi <- setNames(replicate(3, numeric(0), simplify = FALSE), .models)

grab <- function(db, m, tr, col) {
  v <- cox_all[[col]][cox_all$Database == db & cox_all$Model == m & cox_all$Trajectory == tr]
  if (length(v)) v[1] else NA
}
push <- function(m, e, l, h) {
  fp_est[[m]] <<- c(fp_est[[m]], e)
  fp_lo[[m]]  <<- c(fp_lo[[m]],  l)
  fp_hi[[m]]  <<- c(fp_hi[[m]],  h)
}

for (db in .cohorts) {
  d <- cox_data[[db]]
  fp_rows[[length(fp_rows) + 1]] <- c(
    sprintf("%s (n=%d, events=%d)", .cohort_lab[[db]], nrow(d),
            as.integer(sum(d$Arthritis_Status))),
    rep("", 7))
  for (m in .models) push(m, NA, NA, NA)

  for (tr in .traj_lv) {
    txt <- vapply(.models, function(m) {
      x <- grab(db, m, tr, "HR_CI"); if (is.na(x)) "" else x
    }, character(1))
    fp_rows[[length(fp_rows) + 1]] <- c(paste0("  ", tr), as.character(sum(d$Traj_Label == tr)),
                                        txt[1], spacer, txt[2], spacer, txt[3], spacer)
    for (m in .models) {
      if (tr == .ref_lv) push(m, NA, NA, NA)        # reference group: no point estimate
      else push(m, grab(db, m, tr, "HR"), grab(db, m, tr, "Lower"), grab(db, m, tr, "Upper"))
    }
  }
}

fp_tab <- as.data.frame(do.call(rbind, fp_rows), stringsAsFactors = FALSE)
names(fp_tab) <- c("Subgroup", "N", "Model 1", " ", "Model 2", "  ", "Model 3", "   ")

fp_theme <- forest_theme(
  base_size   = 10,
  core        = list(fg_params = list(hjust = 0, x = 0.01, fontface = "plain"),
                     bg_params = list(fill = c("white", alpha("#E2E2E2", 0.3)))),
  colhead     = list(fg_params = list(hjust = 0, fontface = "bold"),
                     bg_params = list(fill = "#E8F4F8")),
  refline_gp  = gpar(col = "black", lty = "dashed", lwd = 0.8),
  ci_pch      = 16,
  ci_col      = "black",
  ci_fill     = "red",
  ci_lwd      = 1.5,
  footnote_gp = gpar(col = "#636363", fontface = "italic", cex = 0.8),
  vertline_gp = gpar(col = "#d0d0d0", lty = "solid", lwd = 0.5)
)

log_msg("Rendering Figure 5 ...")
x_rng <- replicate(3, c(0, 8), simplify = FALSE)
x_tck <- replicate(3, c(0, 1, 2, 4, 8), simplify = FALSE)

fig5 <- forest(
  fp_tab,
  est       = unname(fp_est),
  lower     = unname(fp_lo),
  upper     = unname(fp_hi),
  ci_column = c(4, 6, 8),
  ref_line  = 1,
  xlim      = x_rng,
  ticks_at  = x_tck,
  arrow_lab = c("Protective", "Risk"),
  xlab      = "Hazard Ratio (95% CI)",
  nudge_y   = 0,
  theme     = fp_theme
)

print(fig5)
CairoPDF(out_path("Figure5.pdf"), width = 13, height = 5)
